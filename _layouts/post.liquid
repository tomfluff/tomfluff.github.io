---
layout: default
---
{% assign year = page.date | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}
{% assign url_beginning = page.url | slice: 0, 6 %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  {%- comment -%}
    Local change: the title is the largest text on the page, the post's description
    follows as a summary, and date, reading time and category share one line, with tags
    as small links underneath.
  {%- endcomment -%}
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description and url_beginning == '/blog/' %}
      <p class="post-summary">{{ page.description }}</p>
    {% endif %}
    {% assign read_time = content | strip_html | number_of_words | divided_by: 180 | plus: 1 %}
    {% assign last_date = page.last_modified_at | default: page.last_updated %}
    <p class="post-meta">
      <time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: '%B %-d, %Y' }}</time>
      {% if last_date %}
        <span aria-hidden="true">&middot;</span> updated
        <time datetime="{{ last_date | date_to_xmlschema }}">{{ last_date | date: '%B %-d, %Y' }}</time>
      {% endif %}
      {% if url_beginning == '/blog/' %}
        <span aria-hidden="true">&middot;</span> {{ read_time }} min read
      {% endif %}
      {% if categories != '' %}
        {% for category in page.categories %}
          <span aria-hidden="true">&middot;</span>
          {% if url_beginning == '/blog/' %}
            <a class="post-category" href="{{ category | slugify | prepend: '/blog/category/' | relative_url }}">{{ category | capitalize }}</a>
          {% else %}
            {{ category | capitalize }}
          {% endif %}
        {% endfor %}
      {% endif %}
      {% if page.meta -%}
        <span aria-hidden="true">&middot;</span> {{ page.meta -}}
      {%- endif %}
    </p>
    {% if tags != '' and url_beginning == '/blog/' %}
      <ul class="post-tag-list" aria-label="Tags">
        {% for tag in page.tags %}
          <li>
            <a href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}">#{{ tag }}</a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </header>
  {% if page.audio %}{% include audio_player.liquid %}{% endif %}

  <article class="post-content">
    {% if page.toc and page.toc.beginning %}
      <div id="table-of-contents">
        {% toc %}
      </div>
      <hr>
    {% endif %}
    <div id="markdown-content">
      {{ content }}
    </div>
  </article>

  {% if page.citation %}
    {% include citation.liquid %}
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --group_by none --cited_in_order %}
    </div>
  {% endif %}

  {% assign url_beginning = page.url | slice: 0, 6 %}
  {% if url_beginning == '/blog/' %}
    {% include author_note.liquid %}
  {% endif %}

  {% if site.related_blog_posts and site.related_blog_posts.enabled %}
    {% if page.related_posts == null or page.related_posts %}
      {% include related_posts.liquid %}
    {% endif %}
  {% endif %}

  {%- comment -%}
    Local change: comments sit behind a "Comments" panel. The giscus embed is kept in a
    <template> and only inserted when the panel is first opened (assets/js/site.js), so
    posts do not load the comment widget until someone asks for it.
  {%- endcomment -%}
  {% if site.plugins contains 'al_comments' %}
    {% capture comments_html %}{% include plugins/al_comments.liquid %}{% endcapture %}
    {% assign comments_check = comments_html | strip %}
    {% if comments_check != '' %}
      <details class="post-comments" id="comments">
        <summary>
          <i class="fa-regular fa-comments" aria-hidden="true"></i>
          <span class="post-comments-title">Comments</span>
          <span class="post-comments-hint">Read or join the discussion on GitHub</span>
          <i class="fa-solid fa-chevron-down post-comments-chevron" aria-hidden="true"></i>
        </summary>
        <div class="post-comments-body" data-comments-host></div>
        <template data-comments-template>{{ comments_html }}</template>
      </details>
    {% endif %}
  {% endif %}
</div>
