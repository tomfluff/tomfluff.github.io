<header>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != '/' %}
        <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% social_links %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              {{- about_title }}
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-nav-dropdown-toggle="true"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.cv_pdf %}
            <!-- CV: opens the PDF directly in a new tab (no CV page) -->
            <li class="nav-item">
              <a
                class="nav-link"
                href="{% if site.cv_pdf contains '://' %}{{ site.cv_pdf }}{% else %}{{ site.cv_pdf | prepend: '/assets/pdf/' | relative_url }}{% endif %}"
                target="_blank"
                rel="noopener noreferrer"
              >
                CV
              </a>
            </li>
          {% endif %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" type="button" title="Search (Ctrl K)" aria-label="Search (Ctrl K)">
                <!-- the shortcut hint is meaningless without a keyboard, so phones get the icon alone -->
                <span class="nav-link"><span class="search-shortcut-hint">Ctrl K </span><i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            {%- comment -%}
              Local change: a labelled "Display" button opens a panel with text size, line
              spacing, theme and contrast (assets/js/site.js; styles in
              _sass/_site.scss). It replaces the unlabelled theme icon. theme.js still binds a
              click handler to #light-toggle, so an inert element keeps that id.
            {%- endcomment -%}
            <li class="nav-item display-settings">
              <button id="display-toggle" type="button" class="nav-link" aria-expanded="false" aria-controls="display-panel">
                <i class="fa-solid fa-sliders" aria-hidden="true"></i> Display
              </button>
              <div id="display-panel" class="display-panel" role="group" aria-labelledby="display-panel-title" hidden>
                <p id="display-panel-title" class="display-panel-title">Display</p>
                <fieldset>
                  <legend>Text size</legend>
                  <div class="display-segments">
                    <button type="button" data-display-setting="text-size" data-value="default" aria-pressed="false">Default</button>
                    <button type="button" data-display-setting="text-size" data-value="large" aria-pressed="false">Large</button>
                    <button type="button" data-display-setting="text-size" data-value="larger" aria-pressed="false">Larger</button>
                  </div>
                </fieldset>
                <fieldset>
                  <legend>Line spacing</legend>
                  <div class="display-segments">
                    <button type="button" data-display-setting="line-spacing" data-value="default" aria-pressed="false">Default</button>
                    <button type="button" data-display-setting="line-spacing" data-value="relaxed" aria-pressed="false">Relaxed</button>
                  </div>
                </fieldset>
                <fieldset>
                  <legend>Theme</legend>
                  <div class="display-segments">
                    <button type="button" data-display-setting="theme" data-value="system" aria-pressed="false">System</button>
                    <button type="button" data-display-setting="theme" data-value="light" aria-pressed="false">Light</button>
                    <button type="button" data-display-setting="theme" data-value="dark" aria-pressed="false">Dark</button>
                  </div>
                </fieldset>
                <fieldset>
                  <legend>Contrast</legend>
                  <div class="display-segments">
                    <button type="button" data-display-setting="contrast" data-value="default" aria-pressed="false">Standard</button>
                    <button type="button" data-display-setting="contrast" data-value="high" aria-pressed="false">High</button>
                  </div>
                </fieldset>
                <div class="display-panel-footer">
                  <span>Saved on this device. Browser zoom works too.</span>
                  <button type="button" class="display-reset">Reset</button>
                </div>
              </div>
              <span id="light-toggle" hidden></span>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
<!-- skip-link target: the main content starts right after the header -->
<span id="main-content" tabindex="-1"></span>
