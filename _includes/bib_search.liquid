{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  {%- comment -%}
    Local changes: a visible label instead of a placeholder-only field, and a status line
    that says when nothing matches, with a way to clear the filter (assets/js/site.js).
  {%- endcomment -%}
  <div class="bibsearch">
    <label for="bibsearch" class="bibsearch-label">Filter publications</label>
    <input
      type="text"
      id="bibsearch"
      spellcheck="false"
      autocomplete="off"
      class="search bibsearch-form-input"
      placeholder="Keyword, author, or venue"
      aria-describedby="bibsearch-status"
    >
    <p id="bibsearch-status" class="bibsearch-status" role="status" aria-live="polite"></p>
    <button type="button" class="bibsearch-clear" hidden>Clear filter</button>
  </div>
{% endif %}
