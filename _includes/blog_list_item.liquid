{%- comment -%}
  One entry in the blog index (_pages/blog.md): title, a three-line excerpt, then date,
  reading time and category, with the post's thumbnail on the right.
{%- endcomment -%}
{% assign post = include.post %}
{% if post.external_source == blank %}
  {% assign read_words = post.content | strip_html | number_of_words %}
{% else %}
  {% assign read_words = post.feed_content | strip_html | number_of_words %}
{% endif %}
{% comment %} An external post with no text of its own sets read_time by hand, or shows none. {% endcomment %}
{% if post.read_time %}
  {% assign read_time = post.read_time %}
{% elsif read_words > 0 %}
  {% assign read_time = read_words | divided_by: 180 | plus: 1 %}
{% else %}
  {% assign read_time = null %}
{% endif %}
{% if post.redirect == blank %}
  {% assign post_href = post.url | relative_url %}
{% elsif post.redirect contains '://' %}
  {% assign post_href = post.redirect %}
{% else %}
  {% assign post_href = post.redirect | relative_url %}
{% endif %}
<li class="blog-item">
  <div class="blog-item-text">
    <h2 class="blog-item-title">
      <a href="{{ post_href }}">{{ post.title }}</a>
    </h2>
    {% if post.description %}
      <p class="blog-item-excerpt">{{ post.description | strip_html }}</p>
    {% endif %}
    <p class="blog-item-meta">
      {% if include.pinned %}
        <span class="blog-item-pin"><i class="fa-solid fa-thumbtack" aria-hidden="true"></i> Pinned</span>
        <span aria-hidden="true">&middot;</span>
      {% endif %}
      <time datetime="{{ post.date | date_to_xmlschema }}">{{ post.date | date: '%B %-d, %Y' }}</time>
      {% if read_time %}
        <span aria-hidden="true">&middot;</span>
        {{ read_time }} min read
      {% endif %}
      {% for category in post.categories %}
        <span aria-hidden="true">&middot;</span>
        <a href="{{ category | slugify | prepend: '/blog/category/' | relative_url }}">{{ category | capitalize }}</a>
      {% endfor %}
      {% if post.external_source %}
        <span aria-hidden="true">&middot;</span> {{ post.external_source }}
      {% endif %}
    </p>
  </div>
  {% if post.thumbnail %}
    <img class="blog-item-thumb" src="{{ post.thumbnail | relative_url }}" alt="" loading="lazy">
  {% endif %}
</li>
