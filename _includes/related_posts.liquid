{%- comment -%}
  Local fix: Liquid has no `limit` filter, so the gem's `site.related_posts | limit: n`
  returns every related post and ignores related_blog_posts.max_related. slice does the job.
{%- endcomment -%}
{% assign max_related = site.related_blog_posts.max_related | default: 5 %}
{% assign related_posts = site.related_posts | slice: 0, max_related %}
{% if related_posts != empty %}
  {%- comment -%}
    Local change: related posts as picture cards (thumbnail, title, date and reading
    time) under a "Keep reading" heading, instead of a bulleted list.
  {%- endcomment -%}
  <section class="related-posts" aria-labelledby="related-posts-heading">
    <h2 id="related-posts-heading" class="related-heading">Keep reading</h2>
    <ul class="related-cards">
      {% for post in related_posts %}
        {% if post.redirect == blank %}
          {% assign post_href = post.url | relative_url %}
        {% elsif post.redirect contains '://' %}
          {% assign post_href = post.redirect %}
        {% else %}
          {% assign post_href = post.redirect | relative_url %}
        {% endif %}
        {% assign post_read_time = post.content | strip_html | number_of_words | divided_by: 180 | plus: 1 %}
        <li>
          <a href="{{ post_href }}">
            {% if post.thumbnail %}
              <img src="{{ post.thumbnail | relative_url }}" alt="" loading="lazy">
            {% else %}
              <span class="related-noimage" aria-hidden="true"></span>
            {% endif %}
            <span class="related-title">{{ post.title }}</span>
            <span class="related-meta">{{ post.date | date: '%B %-d, %Y' }} &middot; {{ post_read_time }} min read</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  </section>
{% endif %}
{% if site.newsletter.enabled and site.footer_fixed %}
  <p class="mb-2" style="margin-top: 1.5rem !important">Subscribe to be notified of future articles:</p>
  {% if site.plugins contains 'al_newsletter' %}
    {% include plugins/al_newsletter_form_left.liquid %}
  {% else %}
    {% include newsletter.liquid left=true %}
  {% endif %}
{% endif %}
