{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  {%- comment -%}
    Local change: a visible label and a search icon instead of a placeholder-only field. The
    status line and the clear button sit in _layouts/publications.liquid, under the year and
    venue filters, and are driven by assets/js/site.js.
  {%- endcomment -%}
  <div class="bibsearch">
    <label for="bibsearch" class="bibsearch-label">Filter</label>
    <span class="bibsearch-field">
      <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <input
        type="text"
        id="bibsearch"
        spellcheck="false"
        autocomplete="off"
        class="search bibsearch-form-input"
        placeholder="Keyword, author or venue"
        aria-describedby="bibsearch-status"
      >
    </span>
  </div>
{% endif %}
