<div class="news latest-posts">
  {% assign latest_posts_size = site.posts | size %}
  {% if latest_posts_size > 0 and page.latest_posts.enabled %}
    {% assign latest_posts = site.posts %}
    {% if page.latest_posts.limit %}
      {% assign latest_posts_limit = page.latest_posts.limit %}
    {% else %}
      {% assign latest_posts_limit = latest_posts_size %}
    {% endif %}

    <ul class="latest-posts-list">
      {% for item in latest_posts limit: latest_posts_limit %}
        {% if item.external_source == blank %}
          {% assign read_time = item.content | number_of_words | divided_by: 180 | plus: 1 %}
        {% else %}
          {% assign read_time = item.feed_content | strip_html | number_of_words | divided_by: 180 | plus: 1 %}
        {% endif %}

        <li class="latest-post">
          <h3 class="latest-post-title">
            {% if item.redirect == blank %}
              <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% elsif item.redirect contains '://' %}
              <a href="{{ item.redirect }}" target="_blank" rel="noopener noreferrer">{{ item.title }}</a>
              <svg
                class="latest-post-external"
                width="1rem"
                height="1rem"
                viewBox="0 0 40 40"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="M17 13.5v6H5v-12h6m3-3h6v6m0-6-9 9"
                  class="icon_svg-stroke"
                  stroke="#999"
                  stroke-width="1.5"
                  fill="none"
                  fill-rule="evenodd"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
            {% else %}
              <a href="{{ item.redirect | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </h3>

          {% if item.description %}
            <p class="latest-post-excerpt">{{ item.description | strip_html | truncate: 180 }}</p>
          {% endif %}

          <p class="latest-post-meta">
            <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %d, %Y' }}</time>
            <span aria-hidden="true">&middot;</span>
            {{ read_time }} min read
            {% if item.tags.size > 0 %}
              <span aria-hidden="true">&middot;</span>
              {% for tag in item.tags limit: 3 %}
                <a class="latest-post-tag" href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}">
                  <i class="fa-solid fa-hashtag fa-sm"></i>{{ tag }}
                </a>
              {% endfor %}
            {% endif %}
          </p>
        </li>
      {% endfor %}
    </ul>

    {% if page.latest_posts.limit and latest_posts_size > page.latest_posts.limit %}
      <div class="mb-4" style="text-align: right">
        <a href="{{ '/blog/' | relative_url }}">see all posts &rarr;</a>
      </div>
    {% endif %}
  {% else %}
    <p><i>No available posts to display.</i></p>
  {% endif %}
</div>
